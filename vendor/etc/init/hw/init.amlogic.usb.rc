on property:sys.boot_completed=1
    start adb_usb



# switch to Device mode
on property:sys.usb.config=adb && property:persist.sys.usb.debugging=y
    stop adbd
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x1949
    write /config/usb_gadget/g1/idProduct 0x591
    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/bcdUSB 0x0200
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/functions/accessory.gs2
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "ff400000.dwc2_a"
    start adbd
    setprop sys.usb.state ${sys.usb.config}





service adb_usb /vendor/bin/adb_usb.sh
    group system
    class late_start
    disabled
    oneshot



on property:sys.usb.config=none && property:sys.usb.configfs=1
    setprop sys.usb.ffs.ready 0

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0

on property:sys.usb.config=mtp && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x0681

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x0682

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x0688

# For USB Debugging selinux
on property:sys.usb.debugging=*
    setprop persist.sys.usb.debugging ${sys.usb.debugging}

on property:sys.usb.debug_visible=*
    setprop persist.sys.usb.debug_visible ${sys.usb.debug_visible}

service switch_usb_device /vendor/bin/switch_usb.sh device
    group system
    class late_start
    oneshot
    disabled
    seclabel u:r:switch_usb:s0

service switch_usb_host /vendor/bin/switch_usb.sh
    group system
    class late_start
    oneshot
    disabled
    seclabel u:r:switch_usb:s0

# switch to device  mode
on property:persist.sys.usb.debugging=y
    start switch_usb_device

# switch to HOST mode
on property:persist.sys.usb.debugging=n
    start switch_usb_host

