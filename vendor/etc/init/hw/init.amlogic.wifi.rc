import vendor/etc/init/hw/init.amlogic.usb.rc

# Move it to conn_driver_action.sh to insmod
#on post-fs-data
    #insmod /vendor/lib/modules/cfg80211.ko
    #insmod /vendor/lib/modules/wlan_mt76x8_usb_prealloc.ko
    #insmod /vendor/lib/modules/wlan_mt76x8_usb.ko
    #insmod /vendor/lib/modules/btmtk_usb.ko

#on fs

#service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
#    -ip2p0 -Dnl80211 -c/vendor/etc/wifi/p2p_supplicant.conf \
#    -I/vendor/etc/wifi/bcm_supplicant_overlay.conf \
#    -O/data/vendor/wifi/wpa/sockets \
#    -g@android:wpa_wlan0    \
#   we will start as root and wpa_supplicant will switch to user wifi
#   after setting up the capabilities required for WEXT
#   user wifi
#   group wifi inet keystore
service wpa_supplicant /vendor/bin/hw/wpa_supplicant -g@android:wpa_wlan0 -G1010 -d -O/data/vendor/wifi/wpa/sockets \
    -iwlan0 -Dnl80211 -c /vendor/etc/wifi/wpa_supplicant.conf -I /vendor/etc/wifi/wpa_supplicant_overlay.conf \
    -N -ip2p0 -Dnl80211 -puse_p2p_group_interface=1 -c/vendor/etc/wifi/p2p_supplicant.conf -I/vendor/etc/wifi/p2p_supplicant_overlay.conf
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
