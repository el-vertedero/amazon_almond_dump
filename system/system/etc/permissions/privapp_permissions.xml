    lowstoragemanager will be used to display low storage alert and recommend apps to
    uninstall for clearing storage. PACKAGE_USAGE_STATS and INTERACT_ACROSS_USERS is used in
    showing alert and determining logic while DELETE_PACKAGE and DELETE_CACHE_FILES is used to
    perform storage clearing actions.
    -->
    <privapp-permissions package="com.amazon.device.lowstoragemanager" >
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL"/>
        <permission name="android.permission.DELETE_PACKAGES"/>
        <permission name="android.permission.DELETE_CACHE_FILES"/>
    </privapp-permissions>

    <!--
    storagemanager will be used to host logic of dyno which is storage initiave to offload apps
    which are unused for fix amount of days. PACKAGE_USAGE_STATS and INTERACT_ACROSS_USERS is used
    in determining apps to offload while while DELETE_PACKAGE and DELETE_CACHE_FILES is used to
    perform storage clearing actions.
    -->
    <privapp-permissions package="com.amazon.storage.manager">
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL"/>
        <permission name="android.permission.DELETE_PACKAGES"/>
        <permission name="android.permission.DELETE_CACHE_FILES"/>
    </privapp-permissions>

